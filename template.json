{
  "settings": {
    "analysis": {
      "analyzer": {
        "legit_search_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "english_stop_words",
            "english_stemmer"
          ]
        }
      },
      "filter": {
        "english_stop_words": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "case_name": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "judgment_date": {
        "type": "date"
      },
      "citation_id": {
        "type": "keyword"
      },
      "full_text": {
        "type": "text",
        "analyzer": "legit_search_analyzer"
      },
      "year": {
        "type": "integer"
      }
    }
  }
}